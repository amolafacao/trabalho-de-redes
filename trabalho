#include <stdio.h>

int main() {
    int portas[4] = {22, 53, 80, 443};
    int solicitacoes[8];
    int quantidade;
    int permitidas = 0;
    int bloqueadas = 0;
    int i, j, encontrada;

    printf("Digite a quantidade de solicitacoes (1 a 8): ");
    scanf("%d", &quantidade);

    if (quantidade < 1 || quantidade > 8) {
        printf("Quantidade invalida!\n");
        return 0;
    }

    for (i = 0; i < quantidade; i++) {
        printf("Digite a porta da solicitacao %d: ", i + 1);
        scanf("%d", &solicitacoes[i]);

        if (solicitacoes[i] < 1 || solicitacoes[i] > 65535) {
            printf("Entrada invalida!\n");
            return 0;
        }
    }

    printf("\n--- RESULTADO ---\n");

    for (i = 0; i < quantidade; i++) {
        encontrada = 0;

        for (j = 0; j < 4; j++) {
            if (solicitacoes[i] == portas[j]) {
                encontrada = 1;
                break;
            }
        }

        if (encontrada == 1) {
            printf("%d: PERMITIDA\n", solicitacoes[i]);
            permitidas++;
        } else {
            printf("%d: BLOQUEADA\n", solicitacoes[i]);
            bloqueadas++;
        }
    }

    printf("\nTotal de permitidas: %d\n", permitidas);
    printf("Total de bloqueadas: %d\n", bloqueadas);

    return 0;
}
